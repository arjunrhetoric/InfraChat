# ---- Database (Neon / Supabase / local docker) ----
DATABASE_URL="postgresql://infrachat:infrachat@localhost:5432/infrachat?schema=public"

# ---- Auth.js (NextAuth v5) ----
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# ---- Pusher Channels (managed realtime) ----
# Get from https://dashboard.pusher.com
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap2"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- OAuth (NextAuth: Google + GitHub) ----
# Google: console.cloud.google.com → Credentials → OAuth client (Web).
# GitHub: github.com/settings/developers → OAuth Apps → New OAuth App.
# Redirect URIs (add BOTH):
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/github
#   https://<your-prod-domain>/api/auth/callback/google
#   https://<your-prod-domain>/api/auth/callback/github
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# ---- Uploads (local dev → Vercel Blob in prod, required on Vercel) ----
# UPLOAD_DIR="./public/uploads" (default)
# BLOB_READ_WRITE_TOKEN="" (Vercel Blob, optional)

# ---- Rate limit / cooldown (optional, multi-instance) ----
# When set, rate limits + command cooldowns use Redis instead of memory.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
